<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="kproxyd relay"
    Manufacturer="kproxy"
    Language="1033" Codepage="1252"
    Version="$(var.Version)"
    Scope="perMachine"
    UpgradeCode="508A0278-323D-4A77-B195-A114D860FDC5">
    <MajorUpgrade DowngradeErrorMessage="A newer version of kproxyd is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="kproxyd">
        <Component Id="MainExecutable" Guid="*">
          <File Id="KPROXYD_EXE" Name="kproxyd.exe" Source="$(var.ExePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="kproxyd relay" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>